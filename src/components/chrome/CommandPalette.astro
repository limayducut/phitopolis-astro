---
// CommandPalette.tsx: ⌘K / Ctrl+K command palette in an MUI Modal, plus the
// hotkey hint chip (AppShell passes showShortcut = import.meta.env.DEV, so the
// chip exists only in development, exactly as in fresko). Rows are rendered by
// shared/components/CommandPalette.ts from commandActions.ts.
const showShortcut = import.meta.env.DEV;
---
<div class="cmdk" data-cmdk hidden>
  <div class="cmdk__backdrop" data-cmdk-backdrop aria-hidden="true"></div>
  <div class="cmdk__dialog" role="dialog" aria-modal="true" aria-label="Command palette" tabindex="-1" data-cmdk-dialog>
    <div class="cmdk__prompt">
      <span class="cmdk__caret" aria-hidden="true">❯</span>
      <div class="cmdk__input-root">
        <input
          class="cmdk__input"
          type="text"
          placeholder="Type a command…"
          role="combobox"
          aria-expanded="true"
          aria-controls="cmdk-listbox"
          aria-autocomplete="list"
          aria-label="Search commands"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          data-cmdk-input
        />
      </div>
      <span class="cmdk__mono cmdk__shrink">esc</span>
    </div>
    <ul class="cmdk__list" role="listbox" id="cmdk-listbox" aria-label="Commands" data-lenis-prevent data-cmdk-list></ul>
    <div class="cmdk__signal" data-cmdk-signal hidden>
      <div class="cmdk__signal-head">
        <p class="cmdk__mono">signal</p>
        <p class="cmdk__mono cmdk__mono--dark">sim</p>
      </div>
      <pre class="cmdk__pre" aria-hidden="true" data-cmdk-signal-text></pre>
      <span class="cmdk__status" role="status" data-cmdk-signal-status></span>
    </div>
    <div class="cmdk__foot">
      <p class="cmdk__mono">↑↓ navigate</p>
      <p class="cmdk__mono">↵ run</p>
      <p class="cmdk__mono cmdk__push">Navigate</p>
    </div>
  </div>
</div>

{
  showShortcut && (
    <button class="cmdk-chip" type="button" data-cmdk-chip aria-label="Open command palette (Control K)">
      Ctrl K
    </button>
  )
}

<style is:global>
  .cmdk[hidden] {
    display: none;
  }

  /* MUI Modal root */
  .cmdk {
    position: fixed;
    inset: 0;
    z-index: 1300;
  }

  /* MUI Backdrop (Fade 225ms in / 195ms out) */
  .cmdk__backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: rgba(10, 42, 102, 0.2);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    -webkit-tap-highlight-color: transparent;
    opacity: 0;
    transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cmdk[data-state="open"] .cmdk__backdrop {
    opacity: 1;
  }

  .cmdk[data-state="closing"] .cmdk__backdrop {
    opacity: 0;
    transition-duration: 195ms;
  }

  .cmdk__dialog {
    position: fixed;
    top: 16vh;
    left: 50%;
    transform: translateX(-50%);
    width: min(620px, calc(100vw - 32px));
    overflow: hidden;
    outline: none;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background-color: #f8fafc;
    box-shadow: 0 24px 64px rgba(10, 42, 102, 0.18);
    animation: cmdkIn 150ms ease-out;
  }

  @keyframes cmdkIn {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(-6px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0) scale(1);
    }
  }

  .cmdk[data-state="closing"] .cmdk__dialog {
    opacity: 0;
    transition: opacity 195ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cmdk p,
  .cmdk pre,
  .cmdk ul {
    margin: 0;
  }

  .cmdk__prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid #d1d5db;
  }

  .cmdk__caret {
    color: #ffc72c;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 15px;
    line-height: 1;
  }

  /* MUI InputBase fullWidth */
  .cmdk__input-root {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 100%;
    color: #0a2a66;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 14px;
    line-height: 1.4375em;
    cursor: text;
  }

  .cmdk__input {
    display: block;
    box-sizing: content-box;
    width: 100%;
    min-width: 0;
    height: 1.4375em;
    margin: 0;
    padding: 4px 0 5px;
    border: 0;
    background: none;
    color: currentColor;
    font: inherit;
    letter-spacing: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .cmdk__input:focus,
  .cmdk__input:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .cmdk__input::placeholder {
    color: #5c719d;
    opacity: 0.8;
  }

  .cmdk__mono {
    color: #5c719d;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 10px;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cmdk__mono--dark {
    color: #e5b228;
  }

  .cmdk__shrink {
    flex-shrink: 0;
  }

  .cmdk__push {
    margin-left: auto !important;
  }

  .cmdk__list {
    max-height: 320px;
    overflow-y: auto;
    padding: 4px 0;
    list-style: none;
  }

  .cmdk__empty {
    padding: 12px 16px;
  }

  .cmdk__group-label {
    padding: 10px 16px 4px;
  }

  .cmdk__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cmdk__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 16px;
    border-left: 2px solid transparent;
    background-color: transparent;
    cursor: pointer;
  }

  .cmdk__row[aria-selected="true"] {
    border-left-color: #ffc72c;
    background-color: rgba(255, 199, 44, 0.1);
  }

  .cmdk__row-label {
    color: #0a2a66;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 13px;
    line-height: 1.65;
  }

  .cmdk__hint {
    flex-shrink: 0;
  }

  .cmdk__hint[data-active] {
    color: #ffc72c;
  }

  .cmdk__hint[data-copied] {
    color: #e5b228;
  }

  .cmdk__signal {
    padding: 10px 16px;
    border-top: 1px solid #d1d5db;
  }

  .cmdk__signal[hidden] {
    display: none;
  }

  .cmdk__signal-head {
    display: flex;
    justify-content: space-between;
    padding-bottom: 4px;
  }

  .cmdk__pre {
    min-height: calc(3 * 1.7em);
    color: #0a2a66;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .cmdk__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .cmdk__foot {
    display: flex;
    gap: 16px;
    padding: 8px 16px;
    border-top: 1px solid #d1d5db;
    background-color: #f4f7fc;
  }

  /* Hotkey hint chip (DEV only): precise pointers on desktop widths. */
  .cmdk-chip {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 1400;
    display: none;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    background-color: #f8fafc;
    color: #5c719d;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition:
      border-color 120ms ease,
      color 120ms ease;
  }

  @media (pointer: fine) and (min-width: 900px) {
    .cmdk-chip {
      display: inline-flex;
    }
  }

  .cmdk-chip:hover,
  .cmdk-chip:focus-visible {
    border-color: #ffc72c;
    color: #0a2a66;
  }
</style>
