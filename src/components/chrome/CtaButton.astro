---
// CtaButton.tsx — the site's one CTA, rendered as fresko renders it: an MUI
// Button (contained = primary, outlined = secondary) through SpecularButton,
// so it carries the pointer-aimed WebGL rim (ui/specular/SpecularFx.ts) and
// MUI's touch ripple (ui/touchRipple.ts). Both are attached by initChrome()
// to every [data-cta].
//
// Contract (stable; home-flow uses it): href, label, tone, ground, endIcon, class, style.
import "./buttonBase.css";
import "../../fresko/shared/components/ui/specular/specular.css";

interface Props {
  href?: string;
  label: string;
  tone?: "primary" | "secondary";
  /** The ground it sits on; only changes the secondary (see CtaButton.tsx). */
  ground?: "dark" | "light";
  endIcon?: "arrow";
  fullWidth?: boolean;
  class?: string;
  style?: string;
}
const {
  href = "#",
  label,
  tone = "primary",
  ground,
  endIcon,
  fullWidth = false,
  class: className,
  style,
} = Astro.props;
// Specular rim colour: frost, except a light-ground secondary (slate).
const rim = tone === "secondary" && ground === "light" ? "#94A3B8" : "#F4F7FC";
---
<a
  class:list={[
    "cta",
    `cta--${tone}`,
    ground && tone === "secondary" && `cta--on-${ground}`,
    fullWidth && "cta--full",
    className,
  ]}
  href={href}
  style={style}
  data-cta
  data-specular-line={rim}
>{label}{
    endIcon === "arrow" && (
      <span class="cta__end-icon">
        <svg class="cta__icon" focusable="false" aria-hidden="true" viewBox="0 0 24 24">
          <path d="m12 4-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" />
        </svg>
      </span>
    )
  }</a>

<style is:global>
  /* MUI ButtonBase + Button root (theme components.ts MuiButton.root). */
  .cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: fit-content;
    min-width: 64px;
    margin: 0;
    padding: 12px 28px;
    outline: 0;
    border-radius: var(--r-control);
    cursor: pointer;
    user-select: none;
    vertical-align: middle;
    -webkit-tap-highlight-color: transparent;
    text-decoration: none;
    font-family: "Outfit", -apple-system, "Helvetica Neue", Arial, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.75;
    letter-spacing: 0.5px;
    text-transform: none;
    white-space: nowrap;
  }

  .cta--full {
    width: 100%;
  }

  /* End icon (MUI Button endIcon, medium): 8px gap, -4px tail, 20px glyph. */
  .cta__end-icon {
    display: inherit;
    margin-right: -4px;
    margin-left: 8px;
  }

  .cta__icon {
    display: inline-block;
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    font-size: 20px;
    fill: currentColor;
    user-select: none;
  }

  /* ── Primary: CTA_PRIMARY_SX (gold fill, frost glow, no hover lift) ── */
  .cta--primary {
    border: 1px solid #ffc72c;
    background-color: #ffc72c;
    background-image: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    color: #0a2a66;
    font-weight: 600;
    box-shadow:
      0 6px 20px rgba(244, 247, 252, 0.22),
      0 2px 8px rgba(6, 18, 38, 0.12);
    transition:
      box-shadow var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  @media (hover: hover) {
    .cta--primary:hover {
      border-color: #ffd966;
      background-color: #ffd966;
      color: #0a2a66;
      box-shadow:
        0 8px 28px rgba(244, 247, 252, 0.32),
        0 3px 10px rgba(6, 18, 38, 0.16);
      transform: none;
    }
  }

  .cta--primary:active {
    border-color: #e5b228;
    background-color: #e5b228;
    color: #0a2a66;
    box-shadow: none;
    transform: none;
  }

  .cta:focus-visible {
    outline: 2px solid #061226;
    outline-offset: 3px;
    box-shadow: 0 0 0 5px #ffd966;
  }

  /* ── Secondary: the theme's outlined glass (tokens follow the ground) ── */
  .cta--secondary {
    border: 1px solid var(--glass-border-1);
    background-color: var(--glass-under);
    background-image: linear-gradient(var(--glass-fill-1), var(--glass-fill-1));
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    color: var(--text-1);
    transition: var(--t-glass);
  }

  @media (hover: hover) {
    .cta--secondary:hover {
      border-color: var(--glass-border-2);
      background-image: linear-gradient(var(--glass-fill-2), var(--glass-fill-2));
      box-shadow:
        var(--glass-shadow-1),
        0 0 20px var(--accent-15);
      transform: none;
    }
  }

  .cta--secondary:active {
    box-shadow: var(--glass-inset);
    transform: none;
  }

  .cta--secondary.cta--on-light {
    border-color: rgba(10, 42, 102, 0.35);
    background-color: transparent;
    background-image: none;
    color: #0a2a66;
  }

  @media (hover: hover) {
    .cta--secondary.cta--on-light:hover {
      border-color: #0a2a66;
      background-color: rgba(10, 42, 102, 0.05);
      background-image: none;
      color: #0a2a66;
    }
  }

  .cta--secondary.cta--on-dark {
    border-color: rgba(244, 247, 252, 0.3);
    color: #f4f7fc;
  }

  @media (hover: hover) {
    .cta--secondary.cta--on-dark:hover {
      border-color: rgba(255, 255, 255, 0.7);
      color: #f4f7fc;
    }
  }
</style>
